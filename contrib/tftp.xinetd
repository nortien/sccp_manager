# default: off
# description: The tftp server serves files using the trivial file transfer \
#	protocol.  The tftp protocol is often used to boot diskless \
#	workstations, download configuration files to network-aware printers, \
#	and to start the installation process for some operating systems.
service tftp
{
	socket_type		= dgram
	protocol		= udp
	wait			= yes
	user			= root
	server			= /usr/sbin/in.tftpd
	# no -c: it lets any client on the network create files under /tftpboot, which is
	# to say hand a phone a configuration or a firmware image of its choosing. The phones
	# only ever read. root is needed for -s (chroot); in.tftpd drops privileges itself.
	server_args		= -s -v /tftpboot -m /etc/asterisk/sccpManagerRewrite.rules
	disable			= no
	per_source		= 11
	cps			= 100 2
	flags			= IPv4
}
