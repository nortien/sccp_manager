<dialTemplate>
  <!-- review 2026-09: this file has no reader. The conf/*.*_template glob copies it into the TFTP
       templates directory, but the dial plan code only reads dial*.xml from the dialplan directory
       and the SIP fallback looks for a file literally named dialplan.xml - never dialplan.xml_template.
       It is served by TFTP and used by nothing; kept as the sample it was meant to be. -->
  <versionStamp>e68d54c1-0354-4b1a-aca4-adffc4b7de2f</versionStamp>
  <TEMPLATE match="3.." timeout="1" />
  <TEMPLATE match="..." timeout="2" />
  <TEMPLATE match="......." timeout="2" />
  <TEMPLATE match="0........" timeout="2" />
  <TEMPLATE match="*" timeout="3" />
</dialTemplate>