msgstr "Настройка сетевых параметров сервера SCCP"

#: conf/sccpgeneral.xml.v433
msgid "Deny Networks / Mask"
msgstr "Запрещенные Подсети"

#: conf/sccpgeneral.xml.v433
msgid "All RFC 1918 addresses are local networks. Should always be at least '0.0.0.0/0.0.0.0'."
msgstr "Все адреса RFC 1918 являются локальными сетями. Всегда должно быть не менее '0.0.0.0/0.0.0.0'."

#: conf/sccpgeneral.xml.v433
msgid "Allow Networks / Mask"
msgstr "Разешенные Подсети"

#: conf/sccpgeneral.xml.v433
msgid "Local Networks / Mask"
msgstr "Локальные сети / Маска"

#: conf/sccpgeneral.xml.v433
